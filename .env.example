# Stripe
# El frontend NO usa claves secretas de Stripe: el cobro lo arma el backend
# (stripe-kraken), que es quien las guarda. Lo unico que consume el navegador
# es este price de prueba, para el modo sandbox.
VITE_STRIPE_TEST_PRICE_ID=price_your_test_price

# Firebase Configuration (Template)
# Estas SI son publicas por diseno de Firebase: identifican al proyecto, no
# autorizan nada. Lo que protege los datos son las reglas de Firestore.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Politica de privacidad (/privacy)
#
# La pagina SOLO existe si PRIVACY_CONTACT_EMAIL esta definida: la politica dice
# que los derechos se ejercen escribiendo a ese correo, y sin correo seria una
# promesa sin a quien dirigirla. Sin ella la ruta responde 404 y ni el pie, ni la
# FAQ, ni el sitemap la enlazan.
#
# Son variables de RUNTIME y de servidor (no llevan el prefijo PUBLIC_ a proposito:
# asi no salen en /_app/env.js ni en el HTML de cada pagina, solo en la politica).
# Basta definirlas en el .env del droplet y reiniciar (el deploy ya carga el .env
# con "set -a && . ./.env" antes del pm2 restart); no hace falta recompilar.
#
# DOS TRAMPAS:
#  1. El deploy lee este archivo con el SHELL: un valor con espacios o simbolos
#     (& ( ) $ ;) va entre COMILLAS DOBLES, o el deploy falla antes de reiniciar pm2
#     y deja el build nuevo debajo del proceso viejo.
#  2. "pm2 restart --update-env" conserva las variables que el proceso ya tenia: para
#     APAGAR la politica no basta BORRAR la linea, hay que dejarla VACIA.
PRIVACY_CONTACT_EMAIL=
# Opcional: persona o empresa responsable del sitio. Si esta, la politica la muestra.
PRIVACY_OPERATOR_NAME=""

# Base de paises por IP (aviso de cookies, precio e idioma inicial)
#
# El pais del visitante sale de su IP con una base LOCAL (DB-IP "IP to Country Lite"): decide si
# pedir consentimiento de cookies, el PRECIO que se muestra y el idioma inicial. El archivo NO vive
# en el repo: lo descarga y lo renueva scripts/actualizar-geoip.sh (cron diario en el droplet, ver
# COOKIES.md; el script lee esta misma variable, tambien desde este .env). La app lo busca en
# /root/data/geoip/dbip-country-lite.mmdb; esta variable es OPCIONAL y solo hace falta para cambiar
# esa ruta (en desarrollo local, por ejemplo). Sin el archivo todo sigue funcionando, pero el pais
# sale como desconocido: el aviso se decide con la zona horaria del navegador y el precio cae al
# de Mexico para todos. Instalar la base ANTES de desplegar.
# GEOIP_DB_PATH=
